# Webhook du salon Discord de la guilde (Paramètres du salon > Intégrations > Webhooks)
E7_DISCORD_WEBHOOK_URL=
# Token du bot Discord (optionnel, uniquement pour `e7showcase bot`)
E7_DISCORD_BOT_TOKEN=
# Dossier des données locales (roster SQLite, captures, rendus). Défaut: dossier utilisateur.
E7_DATA_DIR=
# Langue du client de jeu pour l'OCR: fr | en
E7_GAME_LANG=fr
# Navigateur Chromium/Chrome/Edge à utiliser pour le rendu PNG (optionnel)
E7_CHROMIUM_PATH=
